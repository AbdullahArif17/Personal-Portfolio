# Gemini
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Upstash Vector index created with a hosted embedding model
UPSTASH_VECTOR_REST_URL=https://your-index.upstash.io
UPSTASH_VECTOR_REST_TOKEN=your_upstash_vector_token

# Protects POST /ingest. Generate a long random value and keep it secret.
INGEST_API_KEY=replace_with_a_long_random_secret

# Optional: raises the unauthenticated GitHub API rate limit when ingesting repos.
GITHUB_TOKEN=
