# Next.js portfolio environment

# Sanity CMS (required by the existing portfolio)
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-07-08

# Contact form
RESEND_API_KEY=re_your_resend_api_key

# Optional analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Server-only URL of the separate Vercel FastAPI project.
# Do not add NEXT_PUBLIC_ to this variable.
PORTFOLIO_CHAT_API_URL=https://your-portfolio-api.vercel.app
